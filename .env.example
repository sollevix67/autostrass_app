PORT=3001
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autostrass
DB_USER=autostrass
DB_PASSWORD=change-me

# Secret de signature des jetons JWT, 32 caracteres minimum.
# L'API refuse de signer avec une valeur plus courte : un secret faible rend
# les jetons falsifiables.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-with-32-characters-minimum
